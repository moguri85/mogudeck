# Credenciales de la API de Melee (Ajustes de usuario en melee.gg). No las subas a ningún repositorio.
MELEE_CLIENT_ID=
MELEE_CLIENT_SECRET=

# Si la web va en una subruta (p. ej. https://moguri.es/jupiter) pon BASE_PATH=/jupiter
BASE_PATH=

# Primer usuario administrador (solo se usa si la base de datos está vacía).
# Si dejas la contraseña vacía se genera una y sale en los logs: docker compose logs torneos
ADMIN_USER=admin
ADMIN_PASSWORD=

# Pon 1 cuando la web vaya por HTTPS (recomendado)
COOKIE_SECURE=1

# Opcionales
# SYNC_LIST_SECONDS=600   # cada cuánto se revisa la lista de torneos
# SYNC_LIVE_SECONDS=20    # cada cuánto se refresca un torneo en juego
# TZ=Europe/Madrid
