# Añadir DENTRO del bloque "server { listen 443 ssl; server_name moguri.es; ... }" existente.
# En el .env: BASE_PATH=/jupiter   ·   En Ajustes de la web: URL pública = https://moguri.es/jupiter

location = /jupiter { return 301 /jupiter/; }

location ^~ /jupiter/ {                       # ^~ evita que otros location (php, estáticos) se lo coman
    proxy_pass http://127.0.0.1:3100/;          # la barra final quita el prefijo /jupiter
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}
